<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Portal Dashboard - Vent Engineering</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body { 
            font-family: system-ui, -apple-system, sans-serif; 
            background-color: #f9f9f9; 
            color: #000;
            margin: 0; 
            padding: 20px; 
        }
        .container { 
            max-width: 1200px; 
            margin: 0 auto; 
        }
        /* Navigation Bar */
        .nav { 
            background: #fff; 
            padding: 15px 20px; 
            border: 2px solid #000;
            border-radius: 8px; 
            margin-bottom: 30px; 
            display: flex; 
            gap: 20px; 
            align-items: center;
        }
        .nav a { 
            color: #000; 
            text-decoration: none; 
            font-weight: bold; 
            padding: 8px 12px;
            border-radius: 4px;
            transition: background 0.2s, color 0.2s;
        }
        .nav a:hover, .nav a.active { 
            background: #000; 
            color: #fff; 
        }
        .nav button {
            margin-left: auto;
            background: #000;
            color: #fff;
            border: none;
            padding: 10px 20px;
            font-weight: bold;
            border-radius: 4px;
            cursor: pointer;
        }
        .nav button:hover {
            background: #333;
        }
        /* Dashboard Layout */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        .summary-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        .card {
            background: #fff;
            border: 2px solid #000;
            padding: 20px;
            border-radius: 8px;
            text-align: center;
        }
        .card h3 { margin: 0 0 10px 0; font-size: 1rem; color: #666; }
        .card .number { font-size: 2.5rem; font-weight: bold; margin: 0; }
        
        .charts-grid { 
            display: grid; 
            grid-template-columns: 1fr 1fr; 
            gap: 20px; 
        }
        .chart-container { 
            background: #fff; 
            padding: 20px; 
            border: 2px solid #000;
            border-radius: 8px; 
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        h2 { margin-top: 0; }
    </style>
</head>
<body>
    <div class="container">
        <div class="nav">
            <a href="dashboard.html" class="active">Dashboard</a>
            <a href="log.html">Log a Ticket</a>
            <a href="admin.html">Settings</a>
            <button id="logoutBtn">Logout</button>
        </div>

        <div class="header">
            <h2>Support Statistics</h2>
        </div>

        <div class="summary-cards">
            <div class="card">
                <h3>Total Tickets</h3>
                <p class="number" id="totalTickets">-</p>
            </div>
            <div class="card">
                <h3>Open / Unresolved</h3>
                <p class="number" id="openTickets">-</p>
            </div>
        </div>

        <div class="charts-grid">
            <div class="chart-container">
                <h3 style="width: 100%; text-align: center;">Tickets by Status</h3>
                <div style="position: relative; height:300px; width:100%">
                    <canvas id="statusChart"></canvas>
                </div>
            </div>
            
            <div class="chart-container">
                <h3 style="width: 100%; text-align: center;">Issues by Category</h3>
                <div style="position: relative; height:300px; width:100%">
                    <canvas id="categoryChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-app.js";
        import { getAuth, onAuthStateChanged, signOut } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-auth.js";
        import { getFirestore, collection, getDocs } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-firestore.js";

        // Your specific Firebase configuration
        const firebaseConfig = {
            apiKey: "AIzaSyCP85SLMa90kxu0lJVLL0qFUWgHZvZsAOM",
            authDomain: "engineercalllog.firebaseapp.com",
            projectId: "engineercalllog",
            storageBucket: "engineercalllog.firebasestorage.app",
            messagingSenderId: "1034676535589",
            appId: "1:1034676535589:web:a3d91c5cf4de54856b9acc",
            measurementId: "G-F5LM9FBQ8Q"
        };

        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);

        // 1. Authentication Check (Locks down the page)
        onAuthStateChanged(auth, (user) => {
            if (!user) {
                // If not logged in, step out of the 'pages' folder and go to index.html
                window.location.href = "../index.html";
            } else {
                // If logged in, fetch the data
                loadDashboardData();
            }
        });

        // 2. Logout Handler
        document.getElementById('logoutBtn').addEventListener('click', () => {
            signOut(auth).then(() => {
                window.location.href = "../index.html";
            });
        });

        // 3. Fetch Data & Render Charts
        async function loadDashboardData() {
            try {
                // Pull all tickets from the 'tickets' collection in Firestore
                const querySnapshot = await getDocs(collection(db, "tickets"));
                const tickets = [];
                querySnapshot.forEach((doc) => {
                    tickets.push(doc.data());
                });

                // Tally up the data
                let openCount = 0;
                const statusCounts = {};
                const categoryCounts = {};

                tickets.forEach(t => {
                    // Count Statuses
                    const status = t.Status || "Unknown";
                    statusCounts[status] = (statusCounts[status] || 0) + 1;
                    if (status === "Open" || status === "Awaiting Parts" || status === "Requires Site Visit") {
                        openCount++;
                    }

                    // Count Categories
                    const category = t.Category || "Unknown";
                    categoryCounts[category] = (categoryCounts[category] || 0) + 1;
                });

                // Update summary cards
                document.getElementById('totalTickets').innerText = tickets.length;
                document.getElementById('openTickets').innerText = openCount;

                // Render the Status Pie Chart
                const ctxStatus = document.getElementById('statusChart').getContext('2d');
                new Chart(ctxStatus, {
                    type: 'doughnut', // Changed to doughnut for a cleaner modern look
                    data: {
                        labels: Object.keys(statusCounts).length > 0 ? Object.keys(statusCounts) : ['No Data'],
                        datasets: [{
                            data: Object.keys(statusCounts).length > 0 ? Object.values(statusCounts) : [1],
                            // Using a greyscale/black color palette to match company colors
                            backgroundColor: Object.keys(statusCounts).length > 0 ? ['#000000', '#444444', '#888888', '#CCCCCC'] : ['#EEEEEE'],
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: { responsive: true, maintainAspectRatio: false }
                });

                // Render the Category Bar Chart
                const ctxCategory = document.getElementById('categoryChart').getContext('2d');
                new Chart(ctxCategory, {
                    type: 'bar',
                    data: {
                        labels: Object.keys(categoryCounts).length > 0 ? Object.keys(categoryCounts) : ['No Data'],
                        datasets: [{
                            label: 'Number of Tickets',
                            data: Object.keys(categoryCounts).length > 0 ? Object.values(categoryCounts) : [0],
                            backgroundColor: '#000000',
                            borderRadius: 4
                        }]
                    },
                    options: { 
                        responsive: true, 
                        maintainAspectRatio: false,
                        scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } },
                        plugins: { legend: { display: false } }
                    }
                });

            } catch (error) {
                console.error("Error fetching tickets: ", error);
                document.getElementById('totalTickets').innerText = "Error";
            }
        }
    </script>
</body>
</html>
